data("Prestige")
help("Prestige")
head(Prestige)
Prestige$prof <- ifelse(Prestige$type == "prof", 1, 0)
Prestige$bw <- ifelse(Prestige$type %in% c("bc", "wc"), 0, 1)
#Confirming that new variables work correctly
table(Prestige$type, Prestige$prof)
model_1 <- lm(prestige ~ income + prof + income:prof, data = Prestige)
summary(model_1)
stargazer(data.frame(Residuals = model_1),
type = "latex",
title = "Summary of Residuals -1",
digits = 4,
out = "model_1.tex")
stargazer(data.frame(Residuals = model_1),
type = "latex",
title = "Summary of Residuals",
digits = 4,
out = "model_1.tex")

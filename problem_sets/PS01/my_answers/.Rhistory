convert_mark_to_grade <- function(mark) {
if (mark >= 70) {
grade <- "I"
} else if (mark >= 60) {
grade <- "II.1"
} else if (mark >= 50) {
grade <- "II.2"
} else {
grade <- "F"
}
grade
}
grade
